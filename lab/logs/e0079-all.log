        best
    }

    /// Те же хиты в wire-представлении: `MatchResult` подписывается именно по ним (§8.4).
    pub fn matches(&self, hits: &[(u32, u32)]) -> Vec<Match> {
        hits.iter()
            .filter_map(|(d2, slot)| {
-- документированная уверенность, которую проверяет тест (1):
    /// Кадр для `on_frame`, без TLV.
    ///
    /// Кадр не подписывается: подпись `Publish` опциональна (§5.3), а `owner_ed25519` в теле узел
    /// сверяет с PoW-привязкой, так что подделка не даёт ничего.
    pub fn frame(&self) -> Vec<u8> {
        self.msg(Vec::new()).encode_unsigned()
    }
}
-- обещание спеки (строка 1392):
1392:Векторы атак и границы: (i) flood publish → квоты + PoW + evict по `pow_bits`; (ii) дорогой find → bucket 5/с на ключ; ни rerank-пути, ни очереди поиска с ограничением по времени на узле нет — кадр обрабатывается синхронно, усиление стоимости измерено `E-0037` и ограничено только квотой ключа (`ADR-0008`); (iii) надувание DHT-записей → 64 ключа, членство не читается из DHT (§9.2); (iv) надувание кластеров (подделанные embedding'ы, слитые в один горячий центроид) → **защиты нет**: per-cluster admission cap в коде не реализован, а балансировка `cap 2×` работает только при построении артефакта, то есть на уже принятые записи не влияет. Что ограничивает поток реально: per-key publish-бакет и узловой бюджет 100 admits/с (§11.3.4), evict по cheapest `pow_bits` (§11.4) и потолок таблицы приёмов — `MAX_ACCEPTS = 100 000` живых приёмов (§12.3, `rendezvous.rs`); ни одно из них не зависит от заполненности кластера, поэтому слив в один центроид даёт линейный рост скана этой ячейки. Адаптивная `POW_BITS` — предложение, тоже не реализовано (§20.2, строка 4 — не измерено); (v) eclipse — мин. `R=3` владельцев, все 8 шардов узла не могут покрыть зондирование одного запроса.
