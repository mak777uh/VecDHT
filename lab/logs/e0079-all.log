-- pow_input: owner, shard, epoch, slot_key, expires — cluster_id нет:
pub fn pow_input(
    owner_ed25519: &[u8; 32],
    shard: u16,
    epoch: u64,
    slot_key: &[u8; 32],
    expires_bucket: u32,
) -> Vec<u8> {
    let mut w = Writer::new();
    w.extend_raw(POW_DOMAIN);
    w.fixed(owner_ed25519);
    w.u16(shard);
    w.u64(epoch);
    w.fixed(slot_key);
    w.u32(expires_bucket);
    w.into_vec()
}

