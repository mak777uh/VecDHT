    fn decode_body(r: &mut Reader<'_>) -> Result<Self, DecodeError> {
        let preprocessing_version = r.u16()?;
        let query_vector = r.vec_q()?;
        let clusters = r.u16_list()?;
        let top_k = r.u16()?;
        let query_id = r.u64()?;
        let requester_ed25519 = r.fixed()?;
        let tlv = r.tlv_tail()?;
        r.expect_end()?;
        Ok(Find {
            preprocessing_version,
            query_vector,
            clusters,
            top_k,
            query_id,
            requester_ed25519,
            tlv,
        })
    }
}
